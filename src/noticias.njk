---
layout: layout.njk
permalink: /noticias/index.html
title: "Notícias e comunicados"
description: "Acompanhe as notícias, publicações e comunicados."
---
<section class="archive-page">
  <header class="page-header">
    <nav class="breadcrumbs" aria-label="Você está aqui"><a href="/">Início</a><span aria-hidden="true">/</span><span>Notícias</span></nav>
    <h1>Notícias e comunicados</h1>
    <p class="page-description">Acompanhe as publicações e os comunicados mais recentes.</p>
  </header>

  <div class="news-grid news-grid-archive">
    {% for noticia in collections.noticias | reverse %}
      <article class="news-card">
        <a class="news-card-image" href="{{ noticia.url }}" aria-label="Leia: {{ noticia.data.title }}">
          {% if noticia.data.image %}
            <img src="{{ noticia.data.image }}" alt="{{ noticia.data.image_alt or noticia.data.title }}" loading="lazy">
          {% else %}
            <span class="news-placeholder"><i class="far fa-file-alt" aria-hidden="true"></i></span>
          {% endif %}
        </a>
        <div class="news-card-content">
          {% if noticia.data.date %}<time datetime="{{ noticia.data.date }}">{{ noticia.data.date | dataBR }}</time>{% endif %}
          <h2><a href="{{ noticia.url }}">{{ noticia.data.title }}</a></h2>
          {% if noticia.data.description %}<p>{{ noticia.data.description }}</p>{% endif %}
          <a class="text-link" href="{{ noticia.url }}">Ler publicação <span aria-hidden="true">→</span></a>
        </div>
      </article>
    {% else %}
      <p class="empty-state">Ainda não há notícias publicadas.</p>
    {% endfor %}
  </div>
</section>
