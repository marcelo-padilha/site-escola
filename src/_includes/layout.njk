<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description or site.description }}">
  <meta name="theme-color" content="#123b63">
  <title>{% if title and title != 'Página inicial' %}{{ title }} | {% endif %}{{ site.title }}</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <link rel="stylesheet" href="/assets/site.css">
</head>
<body>
  <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

  <div class="top-bar">
    <div class="site-container top-bar-inner">
      <span>{{ site.topbar_text or 'Portal institucional' }}</span>
      <a href="/admin/"><i class="fas fa-lock" aria-hidden="true"></i> Área administrativa</a>
    </div>
  </div>

  <header class="site-header">
    <div class="site-container header-inner">
      <a class="brand" href="/" aria-label="{{ site.title }} — página inicial">
        {% if site.logo %}
          <img class="brand-logo" src="{{ site.logo }}" alt="Logotipo de {{ site.short_title or site.title }}">
        {% else %}
          <span class="brand-symbol" aria-hidden="true"><i class="fas fa-book-open"></i></span>
        {% endif %}
        <span class="brand-text">
          <strong>{{ site.title }}</strong>
          {% if site.short_title %}<small>{{ site.short_title }}</small>{% endif %}
        </span>
      </a>

      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" data-menu-toggle>
        <span class="sr-only">Abrir menu</span>
        <i class="fas fa-bars" aria-hidden="true"></i>
      </button>
    </div>
  </header>

  <nav class="main-nav" aria-label="Navegação principal" id="site-navigation" data-site-nav>
    <div class="site-container nav-inner">
      {% for item in site.navigation %}
        <a href="{{ item.url }}"{% if page.url == item.url %} class="active" aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endfor %}
    </div>
  </nav>

  <main class="site-container main-content" id="conteudo">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="site-container footer-grid">
      <section class="footer-about">
        <h2>{{ site.footer.about_title or 'Sobre' }}</h2>
        {% if site.footer.about_text %}<p>{{ site.footer.about_text }}</p>{% endif %}
      </section>

      {% if site.footer.address or site.footer.email or site.footer.phone %}
      <section class="footer-contact">
        <h2>{{ site.footer.contact_title or 'Contato' }}</h2>
        <ul>
          {% if site.footer.address %}<li><i class="fas fa-map-marker-alt" aria-hidden="true"></i><span>{{ site.footer.address }}</span></li>{% endif %}
          {% if site.footer.email %}<li><i class="far fa-envelope" aria-hidden="true"></i><a href="mailto:{{ site.footer.email }}">{{ site.footer.email }}</a></li>{% endif %}
          {% if site.footer.phone %}<li><i class="fas fa-phone" aria-hidden="true"></i><a href="tel:{{ site.footer.phone }}">{{ site.footer.phone }}</a></li>{% endif %}
        </ul>
      </section>
      {% endif %}

      {% if site.footer.social_links and site.footer.social_links.length %}
      <section class="footer-social">
        <h2>Redes sociais</h2>
        <ul>
          {% for social in site.footer.social_links %}
            {% if social.label and social.url %}<li><a href="{{ social.url }}" target="_blank" rel="noopener noreferrer">{{ social.label }} <i class="fas fa-external-link-alt" aria-hidden="true"></i></a></li>{% endif %}
          {% endfor %}
        </ul>
      </section>
      {% endif %}
    </div>
    <div class="site-container footer-bottom">
      <p>© {{ site.footer.copyright or site.title }}</p>
      <a href="#topo" class="back-to-top" onclick="window.scrollTo({top:0,behavior:'smooth'}); return false;">Voltar ao topo ↑</a>
    </div>
  </footer>

  <script src="/assets/site.js" defer></script>
</body>
</html>
