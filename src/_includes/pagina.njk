---
layout: layout.njk
---
<article class="internal-page">
  <header class="page-header">
    <nav class="breadcrumbs" aria-label="Você está aqui">
      <a href="/">Início</a><span aria-hidden="true">/</span><span>{{ title }}</span>
    </nav>
    <h1>{{ title }}</h1>
    {% if description %}<p class="page-description">{{ description }}</p>{% endif %}
  </header>

  <div class="prose">
    {{ content | safe }}
  </div>

  <div class="page-end-actions">
    <a class="text-link" href="/">← Voltar para a página inicial</a>
  </div>
</article>
