---
layout: layout.njk
permalink: /
title: "Página inicial"
---

<section class="hero-grid" aria-labelledby="hero-title">
  <div class="hero-copy">
    {% if home.hero.eyebrow %}<p class="eyebrow">{{ home.hero.eyebrow }}</p>{% endif %}
    <h1 id="hero-title">{{ home.hero.heading }}</h1>
    <p class="hero-description">{{ home.hero.text }}</p>
    {% if home.hero.button_text and home.hero.button_link %}
      <a class="button button-primary" href="{{ home.hero.button_link }}">
        {{ home.hero.button_text }} <span aria-hidden="true">→</span>
      </a>
    {% endif %}
  </div>
  <div class="hero-media">
    {% if home.hero.banner_image %}
      <img src="{{ home.hero.banner_image }}" alt="{{ home.hero.banner_alt or 'Imagem de destaque' }}">
    {% else %}
      <div class="hero-placeholder" role="img" aria-label="Imagem de destaque não cadastrada">
        <i class="fas fa-graduation-cap" aria-hidden="true"></i>
        <span>Imagem de destaque</span>
      </div>
    {% endif %}
  </div>
</section>

{% if home.quick_cards and home.quick_cards.length %}
<section class="quick-access" aria-label="Acessos rápidos">
  {% for card in home.quick_cards %}
    {% if card.title and card.link %}
      <a class="quick-card" href="{{ card.link }}">
        {% if card.icon %}<i class="{{ card.icon }}" aria-hidden="true"></i>{% endif %}
        <span>{{ card.title }}</span>
        <span class="quick-card-arrow" aria-hidden="true">→</span>
      </a>
    {% endif %}
  {% endfor %}
</section>
{% endif %}

<section class="home-content-grid">
  <div class="home-news">
    <div class="section-heading">
      <div>
        <h2>{{ home.news_section.title }}</h2>
        {% if home.news_section.description %}<p>{{ home.news_section.description }}</p>{% endif %}
      </div>
      <a class="text-link" href="/noticias/">Todas as notícias <span aria-hidden="true">→</span></a>
    </div>

    <div class="news-grid">
      {% for noticia in collections.noticias | reverse %}
        {% if loop.index0 < (home.news_section.limit or 6) %}
          <article class="news-card">
            <a class="news-card-image" href="{{ noticia.url }}" aria-label="Leia: {{ noticia.data.title }}">
              {% if noticia.data.image %}
                <img src="{{ noticia.data.image }}" alt="{{ noticia.data.image_alt or noticia.data.title }}" loading="lazy">
              {% else %}
                <span class="news-placeholder"><i class="far fa-file-alt" aria-hidden="true"></i></span>
              {% endif %}
            </a>
            <div class="news-card-content">
              {% if noticia.data.date %}<time datetime="{{ noticia.data.date }}">{{ noticia.data.date | dataBR }}</time>{% endif %}
              <h3><a href="{{ noticia.url }}">{{ noticia.data.title }}</a></h3>
              {% if noticia.data.description %}<p>{{ noticia.data.description }}</p>{% endif %}
              <a class="text-link" href="{{ noticia.url }}">Ler publicação <span aria-hidden="true">→</span></a>
            </div>
          </article>
        {% endif %}
      {% else %}
        <p class="empty-state">As notícias e os comunicados serão publicados neste espaço.</p>
      {% endfor %}
    </div>
  </div>

  {% if home.sidebar.title or home.sidebar.text or (home.sidebar.links and home.sidebar.links.length) %}
  <aside class="home-sidebar">
    <div class="sidebar-card">
      <span class="sidebar-kicker">Explore</span>
      {% if home.sidebar.title %}<h2>{{ home.sidebar.title }}</h2>{% endif %}
      {% if home.sidebar.text %}<p>{{ home.sidebar.text }}</p>{% endif %}
      {% if home.sidebar.links and home.sidebar.links.length %}
        <ul>
          {% for item in home.sidebar.links %}
            {% if item.title and item.url %}<li><a href="{{ item.url }}">{{ item.title }} <span aria-hidden="true">→</span></a></li>{% endif %}
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </aside>
  {% endif %}
</section>
